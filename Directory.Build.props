<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.16.0</Version>
    <Authors>Jørn Tillnes</Authors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lets `watchme update` find the repo it was built from. -->
    <AssemblyMetadata Include="WatchmeSourceDir" Value="$(MSBuildThisFileDirectory)" />
  </ItemGroup>
</Project>
