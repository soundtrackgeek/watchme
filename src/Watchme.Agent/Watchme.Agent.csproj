<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window, so it can run silently from the Run key at logon. -->
    <OutputType>WinExe</OutputType>
    <!-- Only for the tray icon (NotifyIcon and its menu), which runs on a thread of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Watchme.Core\Watchme.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Watchme.Tests" />
  </ItemGroup>

</Project>
